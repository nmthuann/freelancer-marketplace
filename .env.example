# ═══════════════════════════════════════════════
# DATABASE-PER-SERVICE — mỗi service một Mongo DB riêng
# (có thể cùng 1 Mongo instance, nhưng PHẢI khác dbName)
# ═══════════════════════════════════════════════

# ---- User Service ----
USER_MONGO_URI=mongodb://localhost:27017
USER_MONGO_DB_NAME=fm_user_db

# ---- Post Service ----
POST_MONGO_URI=mongodb://localhost:27017
POST_MONGO_DB_NAME=fm_post_db

# ---- Order Service ----
ORDER_MONGO_URI=mongodb://localhost:27017
ORDER_MONGO_DB_NAME=fm_order_db

# ═══════════════════════════════════════════════
# JWT
# ═══════════════════════════════════════════════
JWT_ACCESS_SECRET_KEY=your_access_secret
JWT_REFRESH_SECRET_KEY=your_refresh_secret

# ═══════════════════════════════════════════════
# TCP transport giữa các microservice
# ═══════════════════════════════════════════════
USER_SERVICE_HOST=localhost
USER_SERVICE_PORT=3301

POST_SERVICE_HOST=localhost
POST_SERVICE_PORT=3302

ORDER_SERVICE_HOST=localhost
ORDER_SERVICE_PORT=3303
